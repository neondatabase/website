{
  "*.{js,jsx,html,css}": "prettier --write",
  "*.{js,jsx}": "eslint --cache --fix",
  "content/{docs,guides,postgresql,branching,faqs}/**/*.{md,mdx}": [
    "node src/scripts/update-frontmatter.js",
    "prettier --write"
  ],
  "content/changelog/**/*.{md,mdx}": "prettier --write",
  "public/pricing.md": "node src/scripts/update-pricing-date.js"
}
